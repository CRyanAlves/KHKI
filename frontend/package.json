{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "config": "node ../scripts/generate-config.cjs",
    "test:config": "node --test ../scripts/generate-config.test.cjs",
    "prestart": "node ../scripts/generate-config.cjs",
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "build": "ng build",
    "prebuild": "node ../scripts/generate-config.cjs",
    "prewatch": "node ../scripts/generate-config.cjs",
    "watch": "ng build --watch --configuration development",
    "test": "node ../scripts/verify-browser.cjs",
    "test:running": "playwright test"
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@lucide/angular": "1.62.0",
    "maplibre-gl": "6.16.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.28",
    "@angular/cli": "21.2.28",
    "@angular/compiler-cli": "21.2.25",
    "@playwright/test": "1.56.1",
    "prettier": "^3.8.1",
    "prettier-plugin-java": "^2.11.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
