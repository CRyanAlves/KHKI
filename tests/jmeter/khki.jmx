              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{"email":"${__P(username,jmeter@khki.test)}","password":"${__P(password,)}","rememberMe":false}</stringProp>
