          <hashTree />
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Contrato JSON" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">try {
  def value = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
  if (!(value instanceof List &amp;&amp; !value.isEmpty() &amp;&amp; value.every { it.name.contains('Café') })) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Resposta JSON incompatível com o contrato esperado.') }
} catch (Exception ignored) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Resposta JSON ausente ou inválida.') }
</stringProp>
          </JSR223Assertion>
          <hashTree />
        </hashTree>
