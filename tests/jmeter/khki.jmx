          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="CSRF da sessão" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">X-XSRF-TOKEN</stringProp>
                <stringProp name="Header.value">${csrfToken}</stringProp>
              </elementProp>
            </collectionProp>
